{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solvanix.github.io/urban-sense-core/schemas/sense-delta-record.schema.json",
  "title": "SENSE Delta Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "entityId", "field", "observedAt", "source", "confidence", "reviewStatus"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
    "entityId": {"type": "string"},
    "field": {"type": "string", "maxLength": 100},
    "previousValue": {},
    "newValue": {},
    "observedAt": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "source": {"$ref": "sense-source.schema.json"},
    "confidence": {"enum": ["low", "medium", "high"]},
    "publicSummary": {"type": "string", "maxLength": 400},
    "impact": {"type": "string", "maxLength": 300},
    "reviewStatus": {"enum": ["needs_review", "verified", "published", "expired", "rejected"]},
    "reviewNote": {"type": "string", "maxLength": 500}
  }
}
