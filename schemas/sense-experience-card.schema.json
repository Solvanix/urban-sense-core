{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solvanix.github.io/urban-sense-core/schemas/sense-experience-card.schema.json",
  "title": "SENSE Experience Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "place", "promise", "steward", "status", "safety", "communityBenefit", "lastReviewed"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 140},
    "place": {"type": "string", "maxLength": 160},
    "promise": {"type": "string", "maxLength": 400},
    "audience": {"type": "array", "items": {"type": "string"}},
    "steward": {"type": "string", "maxLength": 240},
    "duration": {"type": "string", "maxLength": 80},
    "capacity": {"type": "string", "maxLength": 120},
    "steps": {"type": "array", "items": {"type": "string", "maxLength": 300}},
    "notIncluded": {"type": "array", "items": {"type": "string", "maxLength": 300}},
    "safety": {"type": "array", "items": {"type": "string", "maxLength": 300}},
    "accessibility": {"type": "array", "items": {"type": "string", "maxLength": 300}},
    "communityBenefit": {"type": "string", "maxLength": 400},
    "consentStatus": {"enum": ["not_started", "requested", "recorded", "restricted"]},
    "status": {"enum": ["concept", "prototype", "needs_local_review", "tested", "paused", "archived"]},
    "source": {"$ref": "sense-source.schema.json"},
    "lastReviewed": {"type": "string", "format": "date"},
    "nextTest": {"type": "string", "maxLength": 400}
  }
}
