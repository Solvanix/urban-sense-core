# Copy this file to .env.runtime on the target machine. Never commit .env.runtime.
# Generate distinct high-entropy values for every placeholder before use.

APP_PORT=3000
APP_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

MYSQL_DATABASE=urban_sense_demo
MYSQL_USER=urban_sense_app
MYSQL_PASSWORD=replace-with-a-unique-long-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-unique-long-password

# Authentication is deliberately server-selected. Keep AUTH_MODE=manus only for
# the current managed preview; use AUTH_MODE=oidc with a provider owned by the
# operating entity before allowing external production login.
AUTH_MODE=manus
JWT_SECRET=replace-with-a-unique-32-character-minimum-secret
VITE_APP_ID=replace-with-an-oidc-client-id
OAUTH_SERVER_URL=https://issuer.example.invalid
OWNER_OPEN_ID=replace-with-the-owner-subject-id
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional integration settings. Leave blank unless the feature is intentionally enabled.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
