# Database
MYSQL_DATABASE=sense_experience
MYSQL_USER=sense_experience
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
SENSE_EXPERIENCE_DATABASE_URL=mysql://sense_experience:replace-with-a-long-random-password@db:3306/sense_experience

# Public application origin. Replace after the service domain is assigned.
SENSE_EXPERIENCE_WEB_ORIGIN=https://experience.example.org
PORT=3000

# Real provider data remains closed until all values below are configured and
# an active reviewer identity has been provisioned with ops/provision-reviewer.mjs.
SENSE_EXPERIENCE_ACCEPT_REAL_DATA=false
SENSE_EXPERIENCE_OIDC_ISSUER=
SENSE_EXPERIENCE_OIDC_CLIENT_ID=
SENSE_EXPERIENCE_OIDC_CLIENT_SECRET=
SENSE_EXPERIENCE_OIDC_REDIRECT_URI=
SENSE_EXPERIENCE_REVIEWER_SESSION_SECRET=
