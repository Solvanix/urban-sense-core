# Application runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# Database: use a local/test PostgreSQL database only
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/urban_sense_core_dev

# Authentication: configure the selected identity provider outside source control
AUTH_ISSUER_URL=https://issuer.example.invalid
AUTH_CLIENT_ID=replace-me
AUTH_CLIENT_SECRET=replace-me
SESSION_SECRET=replace-with-a-long-random-secret

# Object storage for field evidence
STORAGE_ENDPOINT=https://storage.example.invalid
STORAGE_BUCKET=urban-sense-evidence-dev
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me

# Security and policy
CORS_ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_MAX_BYTES=10485760
RATE_LIMIT_REPORTS_PER_HOUR=10

# SENSE Experience: independent API and reviewer-session boundary.
# Do not reuse DATABASE_URL, credentials, or cookies from Urban-Sense.
SENSE_EXPERIENCE_DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/sense_experience_dev
SENSE_EXPERIENCE_ACCEPT_REAL_DATA=false
SENSE_EXPERIENCE_REVIEWER_SESSION_SECRET=replace-with-a-separate-32-character-minimum-secret
SENSE_EXPERIENCE_WEB_ORIGIN=http://localhost:5173
SENSE_EXPERIENCE_OIDC_ISSUER=https://issuer.example.invalid
SENSE_EXPERIENCE_OIDC_CLIENT_ID=replace-with-independent-reviewer-client-id
SENSE_EXPERIENCE_OIDC_CLIENT_SECRET=replace-with-independent-reviewer-client-secret
SENSE_EXPERIENCE_OIDC_REDIRECT_URI=http://localhost:4000/auth/reviewer/callback
VITE_SENSE_EXPERIENCE_API_URL=http://localhost:4000
# The API stays off until all variables above are configured, real-data acceptance is explicitly approved,
# and one active reviewer identity plus one active role assignment exist in the independent SENSE Experience database.
