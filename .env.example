# Application runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# Database: use a local/test PostgreSQL database only
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/urban_sense_core_dev

# Authentication: configure the selected identity provider outside source control
AUTH_ISSUER_URL=https://issuer.example.invalid
AUTH_CLIENT_ID=replace-me
AUTH_CLIENT_SECRET=replace-me
SESSION_SECRET=replace-with-a-long-random-secret

# Object storage for field evidence
STORAGE_ENDPOINT=https://storage.example.invalid
STORAGE_BUCKET=urban-sense-evidence-dev
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me

# Security and policy
CORS_ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_MAX_BYTES=10485760
RATE_LIMIT_REPORTS_PER_HOUR=10
